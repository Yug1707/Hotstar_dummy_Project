#!/bin/bash
# Baked AMI boot (fix F9). The AMI already has Docker, the pulled image and a *disabled*
# streamlite.service; this script writes the env file and only then starts the service.
# Each step is timestamped in /var/log/hsl-boot.log for E5: "<step> <epoch_s> <os_uptime_s>".
set -euo pipefail
LOG=/var/log/hsl-boot.log
mark() { echo "$1 $(date +%s.%N) $(cut -d' ' -f1 /proc/uptime)" >>"$LOG"; }
mark userdata_start

cat >/etc/streamlite.env <<EOF
WORK_SCALE=${work_scale}
WEB_CONCURRENCY=${web_concurrency}
AWS_REGION=${region}
SSM_MODE=on
EOF
chmod 0644 /etc/streamlite.env
mark env_written

systemctl enable --now streamlite
mark service_started

for _ in $(seq 1 600); do
  if curl -sf -o /dev/null http://127.0.0.1:8000/healthz; then mark app_healthy; exit 0; fi
  sleep 0.1
done
mark app_not_healthy_after_60s
