# Copy to infra/terraform.tfvars (git-ignored) and fill in. Only role A runs `make tf-apply`.
suffix       = "abc123" # same suffix as the hsl-tfstate-<suffix> bucket
owner        = "it457-team"
alert_emails = ["member-a@example.com", "member-b@example.com", "member-c@example.com"]
budget_usd   = 25

# From the c7i-flex.large calibration (T2.7). Changing it rolls the fleet (instance refresh).
work_scale      = "2.0"
web_concurrency = 1

# ami_id comes from infra/ami.auto.tfvars (written by `make ami`).
# image, user_data_mode and enable_loadgen are passed by make (IMAGE=, MODE=, LOADGEN=).
